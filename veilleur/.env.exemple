# Configuration du veilleur — MODÈLE. Copier en `.env` et remplir.
#
# RÈGLE ABSOLUE (KE#107) : TOUTE valeur est entre APOSTROPHES SIMPLES.
# `source .env` est une exécution de shell : une valeur non citée qui contient `>` redirige et crée
# un fichier PORTANT LE NOM du secret, `&` met en arrière-plan et TRONQUE la valeur, `|` tube.
# Le veilleur REFUSE ce fichier si une seule valeur n'est pas citée :
#     python3 -B -m veilleur auditer-env
#
# Aucun secret ici : `SPINDEX_ATTEST_KEY_FILE` nomme un CHEMIN, jamais une clé.

SPINDEX_RPC_URL='https://rpc.mainnet.chain.robinhood.com'
SPINDEX_CHAIN_ID='4663'

# À remplir au déploiement. Tant que ces deux valeurs ne sont pas justes, le veilleur refuse
# bruyamment : il ne vérifie pas un contrat qui n'existe pas.
SPINDEX_REWARDS_ADDR='0x0000000000000000000000000000000000000000'
SPINDEX_REWARDS_DEPLOY_BLOCK='0'

# Multicall3 canonique. Le veilleur vérifie qu'il y a bien du CODE à cette adresse : une adresse
# vide rendrait `0x` à chaque lecture, ce qui ressemblerait à « tous les stakes valent zéro ».
SPINDEX_MULTICALL3='0xcA11bde05977b3631167028862bE2a173976CA11'

# Emplacement des tables publiées (arbitrage Q1). HTTPS obligatoire pour un emplacement distant :
# une table servie en clair est modifiable en vol. Un chemin local est accepté pour la répétition.
SPINDEX_TABLES_BASE_URL='https://spindex.family/tables'

SPINDEX_ATTEST_KEY_FILE='/home/ubuntu/.spindex/veilleur-attest.hex'
# ANCRE DE CONFIANCE de `veilleur vérifier` : la clé publique ATTENDUE, PUBLIQUE, posée HORS de
# l'enveloppe vérifiée. Sans elle, `vérifier` validerait la signature contre la clé que le document
# transporte — c'est-à-dire n'importe qui (KE#130). Un signataire du Safe qui n'a pas ce `.env`
# passe `--clé-publique <hex|fichier>` ; absente des deux côtés, `vérifier` REFUSE.
# La valeur est soit 64 caractères hexadécimaux, soit le chemin d'un fichier qui les contient.
SPINDEX_ATTEST_PUBKEY_FILE='/home/ubuntu/.spindex/veilleur-attest.pub'
SPINDEX_VEILLEUR_STATE_DIR='/home/ubuntu/.local/state/spindex/veilleur-a'

# Exploitation (rapports/veilleur-exploitation.md). Un .env PAR instance : ~/.config/spindex/veilleur-a.env
# sur la machine A, veilleur-b.env sur la machine B (infrastructure indépendante). Rien n'est partagé.
#   - INSTANCE : « a » ou « b ». L'unité lance `--instance %i` ; un désaccord avec ce fichier est refusé.
#   - REPRISE  : « incrémental » (cache figé jusqu'à `finalized`, hash revérifié à chaque passe) ou
#                « complet » (relit tout depuis le déploiement : la référence, lente).
#   - BATTEMENT_DIR : dossier des battements (un fichier par tâche) et de health.json. L'unité le passe
#     aussi en argument (`--battement-dir`), pour battre même si ce fichier est illisible.
SPINDEX_VEILLEUR_INSTANCE='a'
SPINDEX_VEILLEUR_REPRISE='incrémental'
SPINDEX_VEILLEUR_BATTEMENT_DIR='/home/ubuntu/.local/state/spindex/veilleur-a'

# CADENCE DE CETTE INSTANCE — OBLIGATOIRE, aucune valeur par défaut (KE#73). Le service REFUSE de
# démarrer et NOMME la clé manquante.
#
# Pourquoi ce n'est pas dans le code : `a` est lancée par systemd toutes les 5 min sur la machine du
# keeper ; `b` est lancée par GitHub Actions toutes les 15 min (le minimum de la plateforme est 5 min et
# ses exécutions sont retardées ou sautées). Une période en dur dans le paquet scellé faisait publier à
# `b` la borne de `a` (`silence_max_s` 431 s) : la surveillance l'aurait déclarée MUETTE à chaque
# passage. Élargir la borne pour faire taire l'alerte aurait réglé le contrôle sur la panne du sujet
# (KE#121) — c'est la DÉCLARATION qui est propre à l'instance, pas la formule.
#
# `health.json` publie ces valeurs telles quelles et en dérive `silence_max_s` = période + précision +
# délai aléatoire + pire exécution (+ une période par dépassement). Elles sont une DÉCLARATION : la
# surveillance doit la recouper avec les battements réellement observés (`passe` et `ts`), et avec un
# plafond qu'elle tient elle-même — un service ne fixe pas le seuil auquel on l'accuse (KE#130).
#
# Valeurs de `a`, égales à ce que les unités de `systemd/` tiennent réellement (un test relit les timers
# PAR SYSTEMD, `systemd-analyze calendar`, et exige l'égalité avec CE fichier).
#   - PLANIFICATEUR : « systemd » ou « github-actions ». Le nom du timer n'est publié que par systemd.
#   - « non-planifiée » (à la place d'un nombre de secondes) déclare qu'une tâche n'est PAS planifiée sur
#     cette instance : `health.json` publie alors `planifiée: false` et `silence_max_s: null`. C'est le
#     cas des différentiels de `b`, qui ne se lancent qu'à la main. Ne jamais s'en servir pour faire
#     taire une tâche qui, elle, est bien planifiée.
SPINDEX_VEILLEUR_PLANIFICATEUR='systemd'
SPINDEX_VEILLEUR_PERIODE_PASSE_S='300'
SPINDEX_VEILLEUR_PRECISION_PASSE_S='10'
SPINDEX_VEILLEUR_DELAI_ALEATOIRE_PASSE_S='0'
# FILET (facultatif, les deux clés ensemble) : déclencheur de SECOURS dont le retard est MESURÉ. Le
# silence admissible publié devient max(dérivé de la période, FILET + pire) et `health.json` nomme sa source.
# Cas de l'instance b : période 900 s (workflow_dispatch par la surveillance), filet = cron GitHub bridé.
# SPINDEX_VEILLEUR_FILET_PASSE_S='32400'
# SPINDEX_VEILLEUR_FILET_PASSE_SOURCE='29 runs planifies GitHub, ecarts 127 a 471 min, mesure le 2026-09-28'
SPINDEX_VEILLEUR_PERIODE_DIFFERENTIEL_QUOTIDIEN_S='86400'
SPINDEX_VEILLEUR_PRECISION_DIFFERENTIEL_QUOTIDIEN_S='60'
SPINDEX_VEILLEUR_DELAI_ALEATOIRE_DIFFERENTIEL_QUOTIDIEN_S='1800'
SPINDEX_VEILLEUR_PERIODE_DIFFERENTIEL_COMPLET_S='604800'
SPINDEX_VEILLEUR_PRECISION_DIFFERENTIEL_COMPLET_S='60'
SPINDEX_VEILLEUR_DELAI_ALEATOIRE_DIFFERENTIEL_COMPLET_S='1800'

# Paramètres de SÛRETÉ tirés d'une MESURE. Ils vivent ici pour être relevés sans toucher au code,
# et le veilleur REMESURE la fenêtre à chaque passage.
#   - 300 s  : CONSIGNE de publication (règle des 5 min, resserrée après mesure de la fenêtre).
#              La borne qui DÉCIDE est dérivée : fenêtre mesurée − 3 × durée de vérification observée.
#   - 720 s  : seuil de consigne (avertissement permanent) = 1,5 × besoin ; doit être ≥ besoin (refus sinon).
#   - 480 s  : BESOIN de sûreté (règle des 8 minutes de publication, arbitrage Q2-3). La GRAVITÉ des alertes de
#              fenêtre se juge contre lui : P0 sous 1 × besoin, P1 si recul sous 1,5 × besoin, P2 au-dessus.
#              Doit être ≥ la consigne de publication (refus au chargement sinon).
#   La fenêtre de sûreté est le MINIMUM de 3 sondes indépendantes (plusieurs nœuds derrière l'URL, KE#133).
SPINDEX_PUBLISH_DEADLINE_S='300'
SPINDEX_WINDOW_ALERT_S='720'
SPINDEX_WINDOW_NEED_S='480'
SPINDEX_MULTICALL_BATCH='4000'

# --------------------------------------------------------------------------------------------
# PROFIL DU FOURNISSEUR RPC — ce qui est spécifique à un nœud est DÉCLARÉ, jamais figé dans le code.
# Mesures du 2026-09-24 sur la 46630 (`mesures/rpc-fournisseurs-2026-09-24.json`) :
#
#   profil                | plage de journaux max | état historique      | particularité
#   ----------------------|-----------------------|----------------------|------------------------
#   robinhood-officiel    | pas de limite de plage| ~5 000 à 7 000 blocs | 10 000 journaux maximum
#   publicnode            | 50 000 blocs          | < 5 000 blocs (≈19 s)| filtre d'adresse EXIGÉ
#   drpc                  | 101 blocs (MESURÉ)    | ARCHIVE (illimité)   | erreurs en HTTP 400
#
#   - PROFIL : un nom de `veilleur/fournisseurs.py:PROFILS`. Il fixe la taille de tranche par
#     défaut. Un nom inconnu est un ARRÊT qui nomme les profils connus : le veilleur ne devine pas
#     les limites d'un fournisseur qu'il n'a pas mesuré.
#   - MAX_LOG_SPAN : surcharge explicite, en blocs. Sans elle, le client DÉCOUVRE la limite en
#     redécoupant (3 appels perdus par passe sur dRPC) ; le battement expose `plages_découpées`,
#     c'est le signal qu'il est temps de poser la valeur ici.
#   - USER_AGENT : les TROIS fournisseurs refusent `Python-urllib/*` en 403 (Cloudflare 1010).
#     Le client refuse cette valeur avant la première requête.
# SPINDEX_RPC_PROFIL='drpc'
#
# UN FOURNISSEUR PAR RÔLE (au lieu de SPINDEX_RPC_URL / SPINDEX_RPC_PROFIL, jamais en plus) — les QUATRE
# ensemble, profils MESURÉS, sans défaut. Journaux (eth_getLogs, reçus) chez l'un ; état à un bloc, têtes
# et blocs chez l'autre ; eth_chainId demandé aux deux. Battement et health.json publient les HÔTES.
# Mesure du 2026-09-28 : dRPC gratuit sert les journaux mais plus l'état par numéro de bloc.
# SPINDEX_RPC_URL_JOURNAUX='https://robinhood-testnet.drpc.org'
# SPINDEX_RPC_PROFIL_JOURNAUX='drpc'
# SPINDEX_RPC_URL_ETAT='https://rpc.testnet.chain.robinhood.com'
# SPINDEX_RPC_PROFIL_ETAT='robinhood-officiel'
# Les journaux sont RELIÉS à la chaîne du fournisseur d'état avant tout figeage : tête des journaux ≥ fin du
# segment, et blockHash des journaux == hash lu chez l'état. SPINDEX_RPC_RELANCE_* (si posés) s'appliquent
# aux DEUX rôles ; sinon chaque rôle prend la relance déclarée par SON profil.
# SPINDEX_RPC_MAX_LOG_SPAN='101'
# SPINDEX_RPC_USER_AGENT='spindex-veilleur/1 (read-only)'
#
# Profondeur maximale sondée par la dichotomie de fenêtre d'état (200 000 blocs par défaut, soit
# 8 h 40 à la cadence mesurée de 0,156 s/bloc). Sur un nœud d'ARCHIVE, aucune profondeur n'est
# refusée : la fenêtre est alors rendue comme un MINORANT (« au moins N secondes »), et c'est cette
# valeur-ci qui le borne. Elle doit rester largement au-dessus de SPINDEX_WINDOW_NEED_S, sinon le
# minorant ne conclut rien et la passe lève `fenêtre_minorant_sous_besoin`.
# SPINDEX_WINDOW_MAX_DEPTH='200000'
# --------------------------------------------------------------------------------------------

# Sonde de fenêtre : par défaut `SpindexRewards.totalStaked()`, c'est-à-dire le SUJET lui-même.
# Tant que SPINDEX n'est pas déployé, on peut viser une doublure de même forme — le rapport dit alors
# que la mesure vient d'une doublure, jamais l'inverse.
# SPINDEX_WINDOW_PROBE_TO='0x5fc5360d0400a0fd4f2af552add042d716f1d168'
# SPINDEX_WINDOW_PROBE_DATA='0x18160ddd'

# Alertes à mèche longue, bien en amont des J+90 / J+30 du contrat.
SPINDEX_WEEK_UNPOSTED_ALERT_DAYS='7'
SPINDEX_DRAW_UNSETTLED_ALERT_DAYS='3'
